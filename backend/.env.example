# FuturePath AI Counsellor - Groq backend configuration
# Copy this file to backend/.env and enter a new key only in backend/.env.
# Never put a real API key in this example, the frontend, or a VITE_* variable.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AI_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
MAX_CONCURRENT_PER_CLIENT=2
MAX_MESSAGES=40
MAX_MESSAGE_CHARS=4000
MAX_CONVERSATION_CHARS=60000
MAX_CONTEXT_CHARS=60000
