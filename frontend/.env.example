# Optional secure form-delivery endpoint. It must accept POST requests with JSON.
# Leave blank to use the mailto fallback.
VITE_CONTACT_ENDPOINT=

# Optional override for the public contact address. The default address is
# defined once in src/config/contact.js.
VITE_CONTACT_EMAIL=

# URL of the FuturePath AI backend. The backend protects the AI provider API key.
# Run it from the backend folder with: npm install && npm run dev
VITE_AI_API_BASE_URL=http://127.0.0.1:8787

# Optional client-side timeouts in milliseconds.
VITE_AI_TIMEOUT_MS=130000
VITE_AI_CONNECTION_TIMEOUT_MS=8000

# Do not put AI provider API keys in this file or in any VITE_* variable.
# Configure AI_PROVIDER, AI_MODEL, and AI_API_KEY in backend/.env instead.
